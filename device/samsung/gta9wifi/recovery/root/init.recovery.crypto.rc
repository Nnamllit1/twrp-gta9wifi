# SPDX-License-Identifier: Apache-2.0
# Original CYE5 services only; readiness triggers do not block recovery init.
on init
    # libvold also keeps fscrypt-provisioning keys in this session keyring,
    # even when the kernel supports filesystem-level key installation.
    install_keyring

on property:ro.twrp.boot=1
    start gta9wifi_crypto_setup

service gta9wifi_crypto_setup /system/bin/sh /system/bin/gta9wifi-prepare-crypto
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

on property:gta9wifi.crypto.profile_ready=1
    start tz_service

on property:vendor.tzdaemon=Ready
    setprop vendor.TEEGRIS.loaded true
    start tzts_service

on property:vendor.tzts_daemon=Ready
    start vendor.keymint-default
    start vendor.gatekeeper-1-0

service tz_service /vendor/bin/tzdaemon
    class core
    disabled
    user system
    group system readproc
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    seclabel u:r:recovery:s0

service tzts_service /vendor/bin/tzts_daemon
    class core
    disabled
    user system
    group system
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    seclabel u:r:recovery:s0

service vendor.keymint-default /vendor/bin/hw/android.hardware.security.keymint-service
    class early_hal
    disabled
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    disabled
    user system
    group system 5678
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    seclabel u:r:recovery:s0
